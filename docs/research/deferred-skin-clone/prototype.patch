+#[test]
+fn deferred_clone_preserves_borrowed_mesh_and_owned_nurms_inputs(){
+    DEFER_CLONE.store(true,std::sync::atomic::Ordering::Relaxed);
+    let (mut scene,skin,_bone)=fixture();
+    for nurms in [false,true]{
+        let node=scene.node_mut(skin).unwrap();
+        let ObjectKind::EditablePoly(poly)=&mut node.object else{panic!("poly fixture")};
+        poly.subdiv.use_nurms.set(nurms);poly.subdiv.iterations.set(1);
+        scene.set_time(3.0);let serial=scene.clone();let expected=serial.evaluated(skin,None);
+        let actual=scene.evaluated_batch(&[skin],|jobs|{
+            assert_eq!(jobs.len(),1);
+            assert_eq!(matches!(&jobs[0].mesh,std::borrow::Cow::Owned(_)),nurms);
+            parallel(jobs)
+        });
+        compare(&actual[0],&expected);
+    }
+}
